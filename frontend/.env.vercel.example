# Next.js frontend — Vercel Environment Variables
# Set Root Directory = frontend

# Same-origin proxy (preferred). next.config.mjs rewrites /api-backend → Railway.
# On Vercel builds, the app uses /api-backend automatically when VERCEL=1.
API_ORIGIN=https://kambokicks-production.up.railway.app

# Optional override (leave unset on Vercel so the proxy is used):
# NEXT_PUBLIC_API_URL=/api-backend

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
