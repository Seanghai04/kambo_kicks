# Laravel backend — Railway (example, no real secrets)
# Copy values into Railway Variables. Use your Neon + Railway URLs.

APP_NAME=KAMBO-KICKS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kambokicks-production.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FRONTEND_URL=https://kambo-kicks-zeta.vercel.app
SANCTUM_STATEFUL_DOMAINS=kambo-kicks-zeta.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-RAILWAY-BACKEND.up.railway.app/api/auth/google/callback

PAYMENT_WEBHOOK_SECRET=
